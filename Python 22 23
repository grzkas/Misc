        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

nr_z_dziennika = int(input("Podaj numer z dziennika: "))
liczba = 1000 + nr_z_dziennika * 100 + 15

candidate = liczba
while not is_prime(candidate):
    candidate += 1

print(f"Najbliższa liczba pierwsza to: {candidate}")
